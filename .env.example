# OpenAI API key for the App Idea Generator (server-side only)
OPENAI_API_KEY="your_openai_api_key_here"

# Kit.com (ConvertKit) credentials for the opt-in form
KIT_API_KEY="kit_your_api_key_here"
KIT_FORM_ID="your_form_id_here"

# App URL (used for self-referential links, OAuth callbacks)
APP_URL="http://localhost:3000"

# --- Service Business OS (/sbos) founding-seat counter ---
# Upstash Redis stores how many of the 40 founding seats are sold. Without these
# the pages still work: the endpoint reports live:false and the page falls back
# to a flat "Only 40 founding seats" rather than inventing a live count.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# The "secret word" set on the ThriveCart webhook. Leave blank to skip
# validation (not recommended in production).
THRIVECART_SECRET=""

# Long random string. Enables GET/POST /api/admin/seats to inspect or correct
# the seat count. Leave blank to disable that endpoint entirely.
STACK_ADMIN_TOKEN=""

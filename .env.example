# OpenAI API key for the App Idea Generator (server-side only)
OPENAI_API_KEY="your_openai_api_key_here"

# Kit.com (ConvertKit) credentials for the opt-in form
KIT_API_KEY="kit_your_api_key_here"
KIT_FORM_ID="your_form_id_here"
# The app idea generator has its own form, separate from the 70-ideas list, so
# the two magnets do not share a sequence.
KIT_APP_IDEA_FORM_ID=""

# App URL (used for self-referential links, OAuth callbacks)
APP_URL="http://localhost:3000"

# --- Rebrand cutover ---
# Set to "true" only once aiforservicebusinesses.co is attached to the Railway
# service, DNS has propagated and the new domain serves the site. It turns on
# the 301 from thevibecodinglab.co. Flipping it early takes the site down.
LEGACY_REDIRECT="false"

# --- Service Business OS (/sbos) founding-seat counter ---
# Upstash Redis stores how many of the 40 founding seats are sold. Without these
# the pages still work: the endpoint reports live:false and the page falls back
# to a flat "Only 40 founding seats" rather than inventing a live count.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# The "secret word" set on the ThriveCart webhook. Leave blank to skip
# validation (not recommended in production).
THRIVECART_SECRET=""

# Long random string. Enables GET/POST /api/admin/seats to inspect or correct
# the seat count. Leave blank to disable that endpoint entirely.
STACK_ADMIN_TOKEN=""

# --- Stripe -> Kit delivery for The AI Build Standards ---
# Signing secret from the Stripe webhook endpoint screen. Without it the
# endpoint rejects everything, which is the safe default.
STRIPE_WEBHOOK_SECRET=""

# The plink_... id of the payment link, NOT the buy.stripe.com URL. Find it in
# Stripe: Payment links -> click the link -> it is in the dashboard URL.
STRIPE_PLINK_BUILD_STANDARDS=""

# Kit form that delivers the guide. Buyers get subscribed to this on purchase.
KIT_STANDARDS_FORM_ID=""

# Kit's API SECRET, not the API key. Only the secret can read subscriber lists,
# and /standards uses it to confirm a visitor is on the Build Standards form
# before it will open the guide. Without it nobody can get in.
KIT_API_SECRET=""

# Optional. Signs the /standards access cookie. Falls back to
# STRIPE_WEBHOOK_SECRET when unset, so you only need this if you would rather
# the two were not linked.
STANDARDS_ACCESS_SECRET=""
